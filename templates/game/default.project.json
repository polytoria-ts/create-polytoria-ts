{
	"name": "polytoria-ts-game",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"ScriptService": {
			"$className": "ScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"Hidden": {
			"$className": "Hidden",
			"include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@polytoria-ts": {
						"$path": "node_modules/@polytoria-ts"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			}
		},
		"PlayerDefaults": {
			"$className": "PlayerDefaults",
			"TS": {
				"$path": "out/client"
			}
		},
		"Environment": {
			"$className": "Environment"
		}
	}
}
